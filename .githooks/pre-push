#!/bin/sh
# Refuse the push when any commit being published matches a leak pattern.
# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  python3 scripts/leak_check.py --push "$local_sha" "$remote_sha" || status=1
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: push blocked by the leak gate." >&2
fi
exit "$status"
