# Local test configuration. Copy to .env and fill only the environment you intend to use.
# Profile names refer to your external Databricks configuration; no tokens or secrets here.
# Suggested new profile names: bricksmith-free and bricksmith-corporate.
# These BRICKSMITH_* fields are the planned test-harness contract, not Databricks CLI options.

BRICKSMITH_TEST_ENV=free
BRICKSMITH_RUN_REMOTE_TESTS=false
BRICKSMITH_TARGET=ci
BRICKSMITH_TEST_MAX_CONCURRENT_TASKS=2

# Primary development and test workspace.
BRICKSMITH_FREE_PROFILE=
BRICKSMITH_FREE_WORKSPACE_HOST=
BRICKSMITH_FREE_CATALOG=
BRICKSMITH_FREE_SCHEMA_PREFIX=bricksmith_ci
BRICKSMITH_FREE_COMPUTE=serverless

# Optional supplementary workspace for capabilities unavailable on Free Edition.
BRICKSMITH_CORPORATE_PROFILE=
BRICKSMITH_CORPORATE_WORKSPACE_HOST=
BRICKSMITH_CORPORATE_CATALOG=
BRICKSMITH_CORPORATE_SCHEMA_PREFIX=bricksmith_ci
BRICKSMITH_CORPORATE_COMPUTE=serverless
